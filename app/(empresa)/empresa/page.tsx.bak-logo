'use client'

import { useState, useEffect, useCallback } from 'react'
import { useSession } from 'next-auth/react'
import { useRouter } from 'next/navigation'
import Link from 'next/link'
import {
  Users, Plus, Upload, Loader2, AlertTriangle, Printer,
  Trash2, KeyRound, MailWarning, ShoppingCart,
} from 'lucide-react'
import { Header } from '../../../components/Header'
import { Footer } from '../../../components/Footer'

interface Saldo {
  lote_id: string
  curso: { slug: string; titulo: string; nr: string; carga_horaria: string; validade_anos: number }
  vagas_total: number
  vagas_alocadas: number
  vagas_disponiveis: number
  expira_em?: string
}

interface Vaga {
  id: string
  nome: string
  cpf: string
  email?: string
  funcao?: string
  setor?: string
  curso: { slug: string; titulo: string; nr: string }
  status: string
  iniciado_em?: string
  concluido_em?: string
}

interface Resultado {
  ok: boolean
  nome: string
  cpf: string
  senha_provisoria?: string | null
  sem_email?: boolean
  conta_existente?: boolean
  erro?: string
  conflito?: { tipo: string; nome_cadastrado: string; mensagem: string }
}

const fmtCpf = (c: string) =>
  c?.length === 11 ? `${c.slice(0, 3)}.${c.slice(3, 6)}.${c.slice(6, 9)}-${c.slice(9)}` : c

const ROTULO_STATUS: Record<string, { texto: string; cor: string }> = {
  convidado: { texto: 'Não acessou', cor: 'bg-gray-100 text-gray-600' },
  ativo: { texto: 'Em andamento', cor: 'bg-blue-50 text-blue-700' },
  concluido: { texto: 'Concluído', cor: 'bg-green-50 text-green-700' },
  revogado: { texto: 'Cancelado', cor: 'bg-red-50 text-red-600' },
  expirado: { texto: 'Expirado', cor: 'bg-amber-50 text-amber-700' },
}

export default function PainelEmpresa() {
  const { data: session, status } = useSession()
  const router = useRouter()

  const [saldos, setSaldos] = useState<Saldo[]>([])
  const [vagas, setVagas] = useState<Vaga[]>([])
  const [carregando, setCarregando] = useState(true)
  const [aba, setAba] = useState<'um' | 'planilha'>('um')

  const [cursoSel, setCursoSel] = useState('')
  const [novo, setNovo] = useState({ nome: '', cpf: '', email: '', funcao: '', setor: '' })
  const [csv, setCsv] = useState('')
  const [previa, setPrevia] = useState<any>(null)
  const [resultados, setResultados] = useState<Resultado[]>([])
  const [processando, setProcessando] = useState(false)
  const [erro, setErro] = useState('')

  const carregar = useCallback(async () => {
    try {
      const r = await fetch('/api/empresa/vagas')
      if (r.status === 403) {
        router.push('/dashboard')
        return
      }
      const d = await r.json()
      setSaldos(d.saldos ?? [])
      setVagas(d.vagas ?? [])
      if (!cursoSel && d.saldos?.[0]) setCursoSel(d.saldos[0].curso.slug)
    } catch {
      setErro('Não foi possível carregar seus dados. Recarregue a página.')
    } finally {
      setCarregando(false)
    }
  }, [router, cursoSel])

  useEffect(() => {
    if (status === 'unauthenticated') router.push('/login?redirect=/empresa')
    if (status === 'authenticated') carregar()
  }, [status, router, carregar])

  const adicionar = async (confirmarVinculo = false) => {
    setErro('')
    setProcessando(true)
    try {
      const r = await fetch('/api/empresa/vagas', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          curso_slug: cursoSel,
          funcionarios: [{ ...novo, confirmarVinculo }],
        }),
      })
      const d = await r.json()
      if (!r.ok) throw new Error(d.error)
      setResultados(d.resultados)
      if (d.alocados > 0) {
        setNovo({ nome: '', cpf: '', email: '', funcao: '', setor: '' })
        carregar()
      }
    } catch (e: any) {
      setErro(e.message)
    } finally {
      setProcessando(false)
    }
  }

  const enviarCsv = async (confirmar: boolean) => {
    setErro('')
    setProcessando(true)
    try {
      const r = await fetch('/api/empresa/vagas/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ curso_slug: cursoSel, csv, confirmar }),
      })
      const d = await r.json()
      if (!r.ok) throw new Error(d.error)
      if (d.previa) {
        setPrevia(d)
      } else {
        setResultados(d.resultados)
        setPrevia(null)
        setCsv('')
        carregar()
      }
    } catch (e: any) {
      setErro(e.message)
    } finally {
      setProcessando(false)
    }
  }

  const revogar = async (id: string, nome: string) => {
    if (!confirm(`Cancelar a vaga de ${nome}? A vaga volta para o seu saldo.`)) return
    const r = await fetch(`/api/empresa/vagas/${id}`, { method: 'DELETE' })
    const d = await r.json()
    if (!r.ok) {
      alert(d.error)
      return
    }
    carregar()
  }

  const novaSenha = async (id: string, nome: string) => {
    const r = await fetch(`/api/empresa/vagas/${id}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ acao: 'nova_senha' }),
    })
    const d = await r.json()
    if (!r.ok) {
      alert(d.error)
      return
    }
    alert(`Nova senha de ${nome}: ${d.senha_provisoria}\n\nAnote agora — ela não aparece de novo.`)
  }

  const imprimir = () => window.print()

  if (status === 'loading' || carregando) {
    return (
      <>
        <Header />
        <main className="min-h-screen bg-brand-light flex items-center justify-center">
          <Loader2 className="w-6 h-6 animate-spin text-brand-red" />
        </main>
        <Footer />
      </>
    )
  }

  const totalDisponivel = saldos.reduce((a, s) => a + s.vagas_disponiveis, 0)
  const semEmail = vagas.filter((v) => !v.email && v.status !== 'revogado').length
  const comSenha = resultados.filter((r) => r.ok && r.senha_provisoria)

  return (
    <>
      <Header />
      <main className="min-h-screen bg-brand-light py-10 px-4">
        <div className="max-w-5xl mx-auto">
          <div className="flex items-start justify-between mb-8 gap-4 flex-wrap">
            <div>
              <h1 className="font-display text-3xl font-bold text-brand-dark flex items-center gap-3">
                <Users className="w-7 h-7 text-brand-red" /> Painel da empresa
              </h1>
              <p className="text-gray-500 text-sm mt-1">
                Olá, {session?.user?.nome}. Você tem {totalDisponivel} vaga
                {totalDisponivel === 1 ? '' : 's'} disponível{totalDisponivel === 1 ? '' : 'eis'}.
              </p>
            </div>
            <Link href="/empresas" className="btn-primary">
              <ShoppingCart className="w-4 h-4" /> Comprar mais vagas
            </Link>
          </div>

          {erro && (
            <div className="bg-red-50 border border-red-100 rounded-xl p-4 mb-6 text-sm text-red-700">
              {erro}
            </div>
          )}

          {/* saldos */}
          {saldos.length === 0 ? (
            <div className="card text-center py-14 mb-8">
              <Users className="w-14 h-14 text-gray-200 mx-auto mb-4" />
              <h2 className="font-semibold text-brand-dark mb-2">Nenhuma vaga por aqui ainda</h2>
              <p className="text-gray-500 text-sm mb-6">
                Compre vagas para começar a matricular sua equipe.
              </p>
              <Link href="/empresas" className="btn-primary inline-flex">
                Ver planos
              </Link>
            </div>
          ) : (
            <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
              {saldos.map((s) => (
                <div key={s.lote_id} className="card">
                  <span className="text-xs font-semibold text-brand-red">{s.curso.nr}</span>
                  <h3 className="font-semibold text-brand-dark text-sm mb-3 leading-snug">
                    {s.curso.titulo}
                  </h3>
                  <div className="flex items-end justify-between">
                    <div>
                      <p className="text-3xl font-bold text-brand-dark leading-none">
                        {s.vagas_disponiveis}
                      </p>
                      <p className="text-xs text-gray-400 mt-1">
                        de {s.vagas_total} disponíveis
                      </p>
                    </div>
                    {s.expira_em && (
                      <p className="text-xs text-gray-400 text-right">
                        usar até
                        <br />
                        {new Date(s.expira_em).toLocaleDateString('pt-BR')}
                      </p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}

          {/* cadastro */}
          {saldos.length > 0 && (
            <div className="card mb-8">
              <div className="flex gap-4 border-b border-gray-100 mb-5">
                <button
                  onClick={() => { setAba('um'); setPrevia(null) }}
                  className={`pb-3 text-sm font-medium transition-colors ${
                    aba === 'um'
                      ? 'text-brand-red border-b-2 border-brand-red'
                      : 'text-gray-400 hover:text-gray-600'
                  }`}
                >
                  Adicionar funcionário
                </button>
                <button
                  onClick={() => { setAba('planilha'); setResultados([]) }}
                  className={`pb-3 text-sm font-medium transition-colors ${
                    aba === 'planilha'
                      ? 'text-brand-red border-b-2 border-brand-red'
                      : 'text-gray-400 hover:text-gray-600'
                  }`}
                >
                  Importar planilha
                </button>
              </div>

              <label className="block text-sm text-gray-600 mb-1.5">Curso</label>
              <select
                value={cursoSel}
                onChange={(e) => setCursoSel(e.target.value)}
                className="w-full border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-brand-dark mb-5
                           focus:outline-none focus:ring-2 focus:ring-brand-red/30"
              >
                {saldos.map((s) => (
                  <option key={s.lote_id} value={s.curso.slug}>
                    {s.curso.nr} — {s.vagas_disponiveis} vaga
                    {s.vagas_disponiveis === 1 ? '' : 's'}
                  </option>
                ))}
              </select>

              {aba === 'um' ? (
                <>
                  <div className="grid sm:grid-cols-2 gap-3 mb-4">
                    {([
                      ['nome', 'Nome completo'],
                      ['cpf', 'CPF'],
                      ['email', 'E-mail (opcional)'],
                      ['funcao', 'Função (opcional)'],
                      ['setor', 'Setor (opcional)'],
                    ] as const).map(([k, ph]) => (
                      <input
                        key={k}
                        placeholder={ph}
                        value={(novo as any)[k]}
                        onChange={(e) => setNovo({ ...novo, [k]: e.target.value })}
                        className="border border-gray-200 rounded-xl px-4 py-2.5 text-sm text-brand-dark
                                   focus:outline-none focus:ring-2 focus:ring-brand-red/30"
                      />
                    ))}
                  </div>
                  <p className="text-xs text-gray-400 mb-4">
                    Sem e-mail, o funcionário entra com o CPF e uma senha que você imprime.
                  </p>
                  <button
                    onClick={() => adicionar(false)}
                    disabled={processando || !novo.nome || !novo.cpf}
                    className="btn-primary disabled:opacity-50"
                  >
                    {processando ? (
                      <Loader2 className="w-4 h-4 animate-spin" />
                    ) : (
                      <Plus className="w-4 h-4" />
                    )}
                    Adicionar
                  </button>
                </>
              ) : (
                <>
                  <p className="text-sm text-gray-500 mb-3">
                    Cole o conteúdo da planilha. Precisa das colunas <strong>nome</strong> e{' '}
                    <strong>cpf</strong>; e-mail, telefone, função e setor são opcionais.{' '}
                    <a href="/api/empresa/vagas/import" className="text-brand-red hover:underline">
                      Baixar modelo
                    </a>
                  </p>
                  <textarea
                    value={csv}
                    onChange={(e) => { setCsv(e.target.value); setPrevia(null) }}
                    rows={6}
                    placeholder={'nome;cpf;email\nJoão da Silva;123.456.789-09;joao@empresa.com.br'}
                    className="w-full border border-gray-200 rounded-xl px-4 py-3 text-sm font-mono text-brand-dark mb-4
                               focus:outline-none focus:ring-2 focus:ring-brand-red/30"
                  />

                  {previa && (
                    <div className="border border-gray-200 rounded-xl p-4 mb-4">
                      <p className="text-sm text-brand-dark mb-2">
                        <strong>{previa.validos}</strong> de {previa.total_linhas} linhas prontas
                        para cadastrar. Saldo: {previa.saldo_disponivel} vagas.
                      </p>
                      {!previa.suficiente && (
                        <p className="text-sm text-amber-700 flex items-center gap-1.5 mb-2">
                          <AlertTriangle className="w-4 h-4" /> Você não tem vagas para todos. Compre
                          mais ou remova linhas.
                        </p>
                      )}
                      {previa.erros?.length > 0 && (
                        <div className="mt-2 space-y-1">
                          {previa.erros.map((e: any, i: number) => (
                            <p key={i} className="text-xs text-red-600">
                              Linha {e.linha}: {e.motivo} ({e.valor})
                            </p>
                          ))}
                        </div>
                      )}
                    </div>
                  )}

                  <div className="flex gap-3">
                    <button
                      onClick={() => enviarCsv(false)}
                      disabled={processando || !csv.trim()}
                      className="btn-primary disabled:opacity-50"
                    >
                      {processando ? (
                        <Loader2 className="w-4 h-4 animate-spin" />
                      ) : (
                        <Upload className="w-4 h-4" />
                      )}
                      Conferir planilha
                    </button>
                    {previa && previa.validos > 0 && (
                      <button
                        onClick={() => enviarCsv(true)}
                        disabled={processando}
                        className="btn-primary disabled:opacity-50"
                      >
                        Cadastrar {previa.validos}
                      </button>
                    )}
                  </div>
                </>
              )}
            </div>
          )}

          {/* resultados da última operação */}
          {resultados.length > 0 && (
            <div className="card mb-8">
              <div className="flex items-center justify-between mb-4">
                <h2 className="font-display font-bold text-lg text-brand-dark">
                  Acessos gerados agora
                </h2>
                {comSenha.length > 0 && (
                  <button
                    onClick={imprimir}
                    className="text-sm text-brand-red hover:underline flex items-center gap-1.5"
                  >
                    <Printer className="w-4 h-4" /> Imprimir
                  </button>
                )}
              </div>

              {comSenha.length > 0 && (
                <div className="bg-amber-50 border border-amber-100 rounded-xl p-3 mb-4">
                  <p className="text-xs text-amber-900">
                    Anote ou imprima estas senhas agora. Por segurança, elas não podem ser
                    consultadas depois — mas você pode gerar uma nova a qualquer momento.
                  </p>
                </div>
              )}

              <div className="space-y-2">
                {resultados.map((r, i) => (
                  <div
                    key={i}
                    className={`rounded-xl px-4 py-3 text-sm ${
                      r.ok ? 'bg-green-50' : 'bg-red-50'
                    }`}
                  >
                    <div className="flex justify-between items-start gap-3 flex-wrap">
                      <div>
                        <span className="font-medium text-brand-dark">{r.nome}</span>
                        <span className="text-gray-500 ml-2">{fmtCpf(r.cpf)}</span>
                      </div>
                      {r.ok && r.senha_provisoria && (
                        <span className="font-mono font-bold text-brand-dark">
                          senha {r.senha_provisoria}
                        </span>
                      )}
                      {r.ok && !r.senha_provisoria && (
                        <span className="text-xs text-gray-500">já tinha conta — usa a senha dela</span>
                      )}
                    </div>
                    {r.erro && <p className="text-xs text-red-700 mt-1">{r.erro}</p>}
                    {r.conflito && (
                      <div className="mt-2">
                        <p className="text-xs text-red-800">{r.conflito.mensagem}</p>
                        {aba === 'um' && (
                          <button
                            onClick={() => adicionar(true)}
                            className="text-xs text-brand-red hover:underline mt-1.5"
                          >
                            É a mesma pessoa, cadastrar mesmo assim
                          </button>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* lista */}
          {vagas.length > 0 && (
            <div className="card">
              <div className="flex items-center justify-between mb-4 gap-3 flex-wrap">
                <h2 className="font-display font-bold text-lg text-brand-dark">
                  Funcionários ({vagas.filter((v) => v.status !== 'revogado').length})
                </h2>
                {semEmail > 0 && (
                  <span className="text-xs text-amber-700 flex items-center gap-1.5">
                    <MailWarning className="w-4 h-4" />
                    {semEmail} sem e-mail cadastrado
                  </span>
                )}
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="text-left text-gray-400 border-b border-gray-100">
                      <th className="pb-2 font-medium">Nome</th>
                      <th className="pb-2 font-medium">CPF</th>
                      <th className="pb-2 font-medium">Curso</th>
                      <th className="pb-2 font-medium">Situação</th>
                      <th className="pb-2 font-medium text-right">Ações</th>
                    </tr>
                  </thead>
                  <tbody>
                    {vagas.map((v) => {
                      const st = ROTULO_STATUS[v.status] ?? { texto: v.status, cor: 'bg-gray-100' }
                      return (
                        <tr key={v.id} className="border-b border-gray-50 last:border-0">
                          <td className="py-3">
                            <span className="text-brand-dark font-medium">{v.nome}</span>
                            {v.funcao && (
                              <span className="block text-xs text-gray-400">{v.funcao}</span>
                            )}
                          </td>
                          <td className="py-3 text-gray-500">{fmtCpf(v.cpf)}</td>
                          <td className="py-3 text-gray-500">{v.curso?.nr}</td>
                          <td className="py-3">
                            <span className={`text-xs px-2 py-1 rounded-lg ${st.cor}`}>
                              {st.texto}
                            </span>
                          </td>
                          <td className="py-3 text-right whitespace-nowrap">
                            {v.status !== 'revogado' && (
                              <>
                                <button
                                  onClick={() => novaSenha(v.id, v.nome)}
                                  title="Gerar nova senha"
                                  className="text-gray-400 hover:text-brand-red transition-colors p-1"
                                >
                                  <KeyRound className="w-4 h-4" />
                                </button>
                                {!v.iniciado_em && (
                                  <button
                                    onClick={() => revogar(v.id, v.nome)}
                                    title="Cancelar vaga e devolver ao saldo"
                                    className="text-gray-400 hover:text-red-600 transition-colors p-1"
                                  >
                                    <Trash2 className="w-4 h-4" />
                                  </button>
                                )}
                              </>
                            )}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      </main>
      <Footer />
    </>
  )
}
