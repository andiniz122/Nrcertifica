export function gerarHTMLCertificado(cert: any): string {
  const dados = cert.dados
  const cpfFormatado = dados.cpf?.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, '$1.$2.$3-$4')
  const dataInicio = new Date(dados.data_inicio).toLocaleDateString('pt-BR')
  const dataConclusao = new Date(dados.data_conclusao).toLocaleDateString('pt-BR')
  const dataValidade = new Date(dados.data_validade).toLocaleDateString('pt-BR')
  const percentual = Math.round((dados.nota_final / 10) * 100)

  const conteudosPorNR: Record<string, { titulo: string; subtopicos: string[] }[]> = {
    'NR-10': [
      { titulo: '1 - Introdução à NR-10 e Legislação (4 horas)', subtopicos: ['Histórico da NR-10','Objetivos e finalidades da norma','Estrutura legal e aplicabilidade','Responsabilidades dos empregadores e empregados'] },
      { titulo: '2 - Riscos em Instalações e Serviços com Eletricidade (4 horas)', subtopicos: ['Identificação e classificação de riscos elétricos','Avaliação e controle de riscos','Choque elétrico e suas consequências','Efeitos da eletricidade no corpo humano'] },
      { titulo: '3 - Medidas de Controle do Risco Elétrico (4 horas)', subtopicos: ['Medidas preventivas e de proteção coletiva (EPCs)','Procedimentos de segurança aplicáveis','Sistemas de proteção elétrica (SPDA, aterramento, etc.)','Inspeções e manutenções preventivas'] },
      { titulo: '4 - Normas Técnicas Brasileiras (NBR) e Procedimentos Específicos (2 horas)', subtopicos: ['Principais normas aplicáveis ao setor elétrico','Interpretação e aplicação das NBRs relacionadas'] },
      { titulo: '5 - Técnicas de Análise de Risco (4 horas)', subtopicos: ['Metodologias de análise de risco','Estudos de caso','Elaboração de relatórios e documentação de segurança','Identificação e mitigação de riscos'] },
      { titulo: '6 - Equipamentos de Proteção Individual (EPI) e Coletiva (EPC) (4 horas)', subtopicos: ['Tipos de EPIs específicos para eletricidade (luvas, capacetes, calçados, etc.)','Normas de uso, conservação e inspeção','Escolha adequada de EPIs','Tipos de EPCs e suas aplicações (isoladores, barreiras, etc.)'] },
      { titulo: '7 - Documentação de Segurança (2 horas)', subtopicos: ['Prontuário das instalações elétricas','Procedimentos e normas internas','Permissões de trabalho','Responsabilidades documentais'] },
      { titulo: '8 - Trabalho em Altura e em Áreas Classificadas (4 horas)', subtopicos: ['Segurança em trabalhos em altura e áreas confinadas','Procedimentos operacionais','Equipamentos e técnicas específicas'] },
      { titulo: '9 - Segurança em Instalações Elétricas Desenergizadas (4 horas)', subtopicos: ['Procedimentos de desenergização','Técnicas de bloqueio, etiquetagem e aterramento','Liberação de instalações para manutenção'] },
      { titulo: '10 - Segurança em Instalações Elétricas Energizadas (4 horas)', subtopicos: ['Técnicas para trabalhos em alta e baixa tensão','Procedimentos de segurança em serviços sob tensão','Equipamentos e ferramentas adequados para trabalhos energizados'] },
      { titulo: '11 - Primeiros Socorros (4 horas)', subtopicos: ['Atendimento a vítimas de choque elétrico','Técnicas de reanimação cardiopulmonar (RCP)','Tratamento de queimaduras elétricas','Uso de desfibrilador automático (DEA)'] },
      { titulo: '12 - Combate a Incêndios em Instalações Elétricas (2 horas)', subtopicos: ['Identificação de riscos de incêndios elétricos','Uso de extintores apropriados','Procedimentos de evacuação','Plano de emergência para acidentes elétricos'] },
      { titulo: '13 - Acidentes de Origem Elétrica - Análise e Prevenção (4 horas)', subtopicos: ['Estudo de casos reais de acidentes','Medidas corretivas e preventivas','Análise de falhas e implantação de melhorias'] },
      { titulo: '14 - Responsabilidades e Implicações Legais (2 horas)', subtopicos: ['Responsabilidades dos empregadores, empregados e contratantes','Implicações legais em caso de acidentes','Ações corretivas e preventivas exigidas pela NR-10'] },
    ],
    'NR-10 SEP': [
      { titulo: '1 - Sistema Elétrico de Potência (SEP) (4 horas)', subtopicos: ['Definição e estrutura do SEP','Componentes: geração, transmissão e distribuição','Tensões de operação e classificação','Responsabilidades no SEP'] },
      { titulo: '2 - Legislação Complementar ao SEP (4 horas)', subtopicos: ['Regulamentações da ANEEL','Normas técnicas aplicáveis','Procedimentos de rede','Responsabilidades das concessionárias'] },
      { titulo: '3 - Riscos Específicos do SEP (4 horas)', subtopicos: ['Riscos em alta tensão','Arco elétrico e suas consequências','Distâncias de segurança','Zonas de risco e trabalho'] },
      { titulo: '4 - Proteções e Equipamentos no SEP (4 horas)', subtopicos: ['Equipamentos de proteção para alta tensão','Ferramentas isoladas homologadas','Vestimentas de proteção para arco elétrico','Inspeção e manutenção de EPIs'] },
      { titulo: '5 - Procedimentos Operacionais no SEP (4 horas)', subtopicos: ['Manobras em subestações','Procedimentos de desenergização no SEP','Recomposição do sistema','Ordens de serviço e permissões'] },
      { titulo: '6 - Trabalhos em Linhas de Transmissão e Distribuição (4 horas)', subtopicos: ['Trabalhos em potencial (ao potencial)','Trabalhos a distância (com varas)','Trabalhos à distância com ferramentas isoladas','Trabalhos em linhas energizadas'] },
      { titulo: '7 - Trabalhos em Subestações (4 horas)', subtopicos: ['Segurança em subestações de alta tensão','Equipamentos de seccionamento e proteção','Aterramento temporário no SEP','Procedimentos de manobra'] },
      { titulo: '8 - Primeiros Socorros e Emergências no SEP (4 horas)', subtopicos: ['Atendimento a acidentes de alta tensão','Queimaduras por arco elétrico','Resgate em altura e espaços confinados no SEP','Acionamento de equipes de emergência'] },
    ],
    'NR-35': [
      { titulo: '1 - Introdução ao Trabalho em Altura (2 horas)', subtopicos: ['Conceitos e definições da NR-35','Legislação e responsabilidades','Estatísticas de acidentes em altura','Campo de aplicação da norma'] },
      { titulo: '2 - Riscos no Trabalho em Altura (2 horas)', subtopicos: ['Identificação e avaliação de riscos','Fatores de risco: queda, objetos, condições climáticas','Análise de Risco (AR) e Permissão de Trabalho (PT)','Medidas de controle e prevenção'] },
      { titulo: '3 - Equipamentos de Proteção Individual (EPI) (2 horas)', subtopicos: ['Tipos de cinturões e arneses','Talabarte, conectores e trava-quedas','Inspeção antes do uso','Normas de certificação e validade dos EPIs'] },
      { titulo: '4 - Sistemas de Ancoragem e Procedimentos (2 horas)', subtopicos: ['Pontos de ancoragem fixos e móveis','Linhas de vida horizontais e verticais','Sistemas de proteção coletiva (andaimes, plataformas)','Procedimentos de resgate em altura'] },
    ],
    'NR-33': [
      { titulo: '1 - Introdução aos Espaços Confinados (2 horas)', subtopicos: ['Definição e classificação de espaços confinados','Legislação: NR-33 e normas relacionadas','Responsabilidades: empregador, supervisor, vigia e trabalhador','Estatísticas e causas de acidentes'] },
      { titulo: '2 - Identificação e Avaliação de Riscos (4 horas)', subtopicos: ['Riscos atmosféricos: oxigênio, inflamáveis, tóxicos','Riscos físicos e mecânicos','Medição e monitoramento da atmosfera','Classificação do espaço confinado'] },
      { titulo: '3 - Medidas de Controle e Prevenção (4 horas)', subtopicos: ['Isolamento e bloqueio de energias','Ventilação forçada do espaço','Equipamentos de proteção individual e coletiva','Comunicação entre equipe e vigia'] },
      { titulo: '4 - Permissão de Entrada e Trabalho (PET) (2 horas)', subtopicos: ['Elaboração e emissão da PET','Validade e cancelamento da PET','Responsabilidades do supervisor de entrada','Registro e arquivamento'] },
      { titulo: '5 - Procedimentos de Resgate (4 horas)', subtopicos: ['Plano de resgate e emergência','Equipamentos de resgate em espaços confinados','Simulações e treinamentos periódicos','Acionamento de equipes de socorro'] },
    ],
    'NR-06': [
      { titulo: '1 - Introdução aos EPIs (1 hora)', subtopicos: ['Definição e finalidade dos EPIs','Base legal: NR-06 e legislação complementar','Responsabilidades do empregador e do trabalhador','Certificado de Aprovação (CA) do MTE'] },
      { titulo: '2 - Classificação dos EPIs (1 hora)', subtopicos: ['EPIs para proteção da cabeça','EPIs para proteção dos olhos e face','EPIs para proteção auditiva','EPIs para proteção respiratória, mãos, pés e quedas'] },
      { titulo: '3 - Seleção e Uso Correto de EPIs (1 hora)', subtopicos: ['Critérios de seleção por risco','Higienização e conservação','Vida útil e substituição','Treinamento de uso'] },
      { titulo: '4 - Responsabilidades e Documentação (1 hora)', subtopicos: ['Ficha de entrega de EPI','Recusa do trabalhador em usar EPI','Implicações legais','Integração com PPRA e PGR'] },
    ],
  }

  let nrKey = 'NR-10'
  const titulo = dados.titulo_curso || ''
  if (titulo.includes('SEP') || titulo.includes('sep')) nrKey = 'NR-10 SEP'
  else if (titulo.includes('NR-35') || titulo.includes('NR35') || titulo.includes('35')) nrKey = 'NR-35'
  else if (titulo.includes('NR-33') || titulo.includes('NR33') || titulo.includes('33')) nrKey = 'NR-33'
  else if (titulo.includes('NR-06') || titulo.includes('NR06') || titulo.includes('EPI')) nrKey = 'NR-06'

  const conteudo = conteudosPorNR[nrKey] || conteudosPorNR['NR-10']
  const metade = Math.ceil(conteudo.length / 2)
  const col1 = conteudo.slice(0, metade)
  const col2 = conteudo.slice(metade)

  const renderItem = (item: { titulo: string; subtopicos: string[] }) => `
    <div class="item-conteudo">
      <div class="item-titulo">${item.titulo}</div>
      <ul class="item-lista">
        ${item.subtopicos.map(s => `<li>${s}</li>`).join('')}
      </ul>
    </div>`

  const logoPath = 'data:image/svg+xml;base64,'

  return `<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8">
<style>
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Times New Roman',serif; background:white; }

/* ══ FRENTE ══ */
.pagina {
  width:297mm; height:210mm;
  position:relative; overflow:hidden; background:white;
  page-break-after:always;
}
.canto-tl {
  position:absolute; top:0; left:0; width:0; height:0;
  border-style:solid; border-width:52mm 42mm 0 0;
  border-color:#1a1a1a transparent transparent transparent;
}
.canto-tr {
  position:absolute; top:0; right:0; width:0; height:0;
  border-style:solid; border-width:52mm 0 0 42mm;
  border-color:#1a1a1a transparent transparent transparent;
}
.borda-ouro {
  position:absolute;
  top:5mm; left:5mm; right:5mm; bottom:5mm;
  border:0.8mm solid #c9a84c;
}
.borda-ouro2 {
  position:absolute;
  top:7mm; left:7mm; right:7mm; bottom:7mm;
  border:0.2mm solid #c9a84c66;
}
.waves {
  position:absolute; bottom:0; left:0; right:0; height:42mm;
  overflow:hidden;
}
.wave-preto {
  position:absolute; bottom:0; left:-10%; right:-10%; height:42mm;
  background:#111;
  clip-path: ellipse(55% 100% at 50% 100%);
}
.wave-cinza {
  position:absolute; bottom:0; left:-10%; right:-10%; height:34mm;
  background: linear-gradient(90deg, #888 0%, #bbb 50%, #888 100%);
  clip-path: ellipse(52% 95% at 46% 100%);
  opacity:0.5;
}
.wave-ouro {
  position:absolute; bottom:0; left:-10%; right:-10%; height:26mm;
  background: linear-gradient(90deg, #c9a84c 0%, #f0d080 40%, #e8c555 60%, #c9a84c 100%);
  clip-path: ellipse(48% 90% at 42% 100%);
  opacity:0.9;
}
.wave-ouro2 {
  position:absolute; bottom:0; left:-10%; right:-10%; height:16mm;
  background: linear-gradient(90deg, #8b6914 0%, #c9a84c 50%, #8b6914 100%);
  clip-path: ellipse(44% 85% at 38% 100%);
  opacity:0.6;
}
.topo {
  position:absolute; top:5mm; left:8mm; right:8mm;
  display:flex; align-items:center; gap:6mm;
}
.logo-box img {
  width:38mm; height:auto; object-fit:contain;
}
.titulo {
  font-family:Arial Black, Arial, sans-serif;
  font-size:36pt; font-weight:900; color:#1a1a1a;
  letter-spacing:4px; line-height:1;
}
.corpo {
  position:absolute; top:48mm; left:14mm; right:14mm;
  text-align:center;
}
.cert-txt { font-size:13pt; color:#222; line-height:1.9; }
.nome-aluno { font-size:13pt; font-weight:700; color:#1a1a1a; }
.nome-curso {
  font-size:13pt; font-weight:900; color:#1a1a1a;
  margin:3mm 0 2.5mm;
  border-top:0.3mm solid #c9a84c;
  border-bottom:0.3mm solid #c9a84c;
  padding:2mm 0;
}
.legal { font-size:7.5pt; color:#444; line-height:1.7; margin-top:2mm; }
.assinaturas {
  position:absolute; bottom:52mm; left:14mm; right:14mm;
  height:28mm;
}
.assin-aluno {
  position:absolute; bottom:0; left:0; width:50mm; text-align:center;
  padding-top:22mm;
}
.linha-a { border-top:0.4mm solid #333; margin-bottom:2mm; }
.label-a { font-size:10pt; font-weight:700; color:#1a1a1a; }
.medalha-box {
  position:absolute; bottom:0; left:50%; transform:translateX(-50%); width:30mm; text-align:center;
}
.assin-resp {
  position:absolute; bottom:0; right:0; width:75mm; text-align:center;
}
.linha-r { border-top:0.4mm solid #333; margin-bottom:1.5mm; }
.nome-r { font-size:10pt; font-weight:900; color:#1a1a1a; white-space:nowrap; }
.cargo-r { font-size:6.5pt; color:#555; line-height:1.7; margin-top:0.5mm; font-style:italic; }

/* ══ VERSO ══ */
.pagina-verso {
  width:297mm; height:210mm;
  position:relative; overflow:hidden; background:white;
  padding:9mm 13mm 8mm;
}
.verso-header {
  display:flex; align-items:center; gap:4mm;
  border-bottom:0.7mm solid #1a1a1a; padding-bottom:3mm; margin-bottom:3mm;
}
.verso-logo img { width:14mm; height:14mm; object-fit:contain; }
.verso-titulo h1 { font-family:Arial,sans-serif; font-size:12pt; font-weight:900; color:#1a1a1a; }
.verso-titulo h2 { font-size:8pt; color:#555; font-weight:700; margin-top:0.5mm; letter-spacing:1px; }
.grid-cols { display:grid; grid-template-columns:1fr 1fr; gap:0 7mm; }
.item-conteudo { margin-bottom:2.5mm; }
.item-titulo { font-size:6.5pt; font-weight:700; color:#1a1a1a; margin-bottom:0.8mm; }
.item-lista { list-style:disc; padding-left:3.5mm; }
.item-lista li { font-size:5.8pt; color:#333; line-height:1.45; }
.verso-footer {
  position:absolute; bottom:5mm; left:13mm; right:13mm;
  display:flex; align-items:flex-end; justify-content:space-between;
  border-top:0.3mm solid #ddd; padding-top:3mm; gap:6mm;
}
.footer-esq { display:flex; align-items:flex-end; gap:4mm; flex:1; }
.footer-logo img { width:11mm; height:11mm; object-fit:contain; opacity:0.7; }
.base-legal-v { font-size:5.8pt; color:#555; line-height:1.6; }
.codigo-box { font-size:5.5pt; color:#888; background:#f5f5f5; border-radius:1mm; padding:0.8mm 2mm; margin-top:1.5mm; display:inline-block; }
.assin-v { text-align:right; flex:0 0 60mm; }
.linha-v { border-top:0.3mm solid #333; margin-bottom:1.5mm; }
.nome-v { font-size:8.5pt; font-weight:700; color:#1a1a1a; }
.cargo-v { font-size:6pt; color:#444; line-height:1.5; }

@page { size:A4 landscape; margin:0; }
</style></head><body>

<!-- ══ FRENTE ══ -->
<div class="pagina">

  <!-- Cantos pretos triangulares -->
  <div class="canto-tl"></div>
  <div class="canto-tr"></div>

  <!-- Bordas douradas -->
  <div class="borda-ouro"></div>
  <div class="borda-ouro2"></div>

  <!-- Ornamentos dourados nos cantos (linhas diagonais) -->
  <svg style="position:absolute;top:0;left:0;width:55mm;height:58mm;" viewBox="0 0 155 165" xmlns="http://www.w3.org/2000/svg">
    <line x1="0" y1="145" x2="130" y2="0" stroke="#c9a84c" stroke-width="2" opacity="0.8"/>
    <line x1="0" y1="160" x2="145" y2="0" stroke="#f0d080" stroke-width="1" opacity="0.5"/>
  </svg>
  <svg style="position:absolute;top:0;right:0;width:55mm;height:58mm;" viewBox="0 0 155 165" xmlns="http://www.w3.org/2000/svg">
    <line x1="155" y1="145" x2="25" y2="0" stroke="#c9a84c" stroke-width="2" opacity="0.8"/>
    <line x1="155" y1="160" x2="10" y2="0" stroke="#f0d080" stroke-width="1" opacity="0.5"/>
  </svg>

  <!-- Ondas rodapé -->
  <div class="waves">
    <div class="wave-preto"></div>
    <div class="wave-cinza"></div>
    <div class="wave-ouro"></div>
    <div class="wave-ouro2"></div>
  </div>

  <!-- Topo -->
  <div class="topo">
    <div class="logo-box">
      <img src="${logoPath}" alt="NR Certifica" />
    </div>
    <div class="titulo">CERTIFICADO</div>
  </div>

  <!-- Corpo -->
  <div class="corpo">
    <p class="cert-txt">
      Certificamos que <span class="nome-aluno">${dados.nome_aluno}</span>, CPF ${cpfFormatado},<br>
      concluiu com <strong>100% de frequência</strong> o curso com carga horária de <strong>${dados.carga_horaria}:</strong>
    </p>
    <div class="nome-curso">${dados.titulo_curso}</div>
    <p class="legal">
      O Curso foi realizado de <strong>${dataInicio}</strong> à <strong>${dataConclusao}</strong> com base legal na Constituição/88 Artigo 206° Inciso II e Artigo 209°,<br>
      Lei n° 9.394/96, Decreto n° 5.154/2004 e Norma CNE n° 09/99 - MEC (Ministério da Educação) Artigo 7°§ 3°.<br>
      O Aluno obteve aproveitamento de <strong>${percentual}%</strong> na avaliação de conhecimento aplicada no final do curso.
    </p>
  </div>

  <!-- Assinaturas -->
  <div class="assinaturas">
    <div class="assin-aluno">
      <div class="linha-a"></div>
      <div class="label-a">Aluno(a)</div>
    </div>
    <div class="medalha-box">
      <svg width="72" height="82" viewBox="0 0 120 138" xmlns="http://www.w3.org/2000/svg">
        <path d="M45,72 L34,122 L60,107 L86,122 L75,72" fill="#C8102E"/>
        <path d="M45,72 L34,122 L60,107 Z" fill="#9a000e"/>
        <path d="M75,72 L86,122 L60,107 Z" fill="#9a000e"/>
        <circle cx="60" cy="52" r="42" fill="#c9a84c" stroke="#a07820" stroke-width="2"/>
        <circle cx="60" cy="52" r="35" fill="#f0d080" stroke="#c9a84c" stroke-width="1.5"/>
        <circle cx="60" cy="52" r="26" fill="#fffadc"/>
        ${Array.from({length:20},(_,i)=>{const a=i*(360/20)*Math.PI/180;const x1=60+22*Math.cos(a);const y1=52+22*Math.sin(a);const x2=60+35*Math.cos(a);const y2=52+35*Math.sin(a);return`<line x1="${x1.toFixed(1)}" y1="${y1.toFixed(1)}" x2="${x2.toFixed(1)}" y2="${y2.toFixed(1)}" stroke="#c9a84c" stroke-width="1" opacity="0.7"/>`}).join('')}
        <polygon points="60,35 64.5,48 78,48 67,56 71,69 60,61 49,69 53,56 42,48 55.5,48" fill="#c9a84c" stroke="#a07820" stroke-width="0.8"/>
        <polygon points="60,38 63.5,49 75,49 66,56 69.5,67 60,60 50.5,67 54,56 45,49 56.5,49" fill="#f0d080"/>
      </svg>
    </div>
    <div class="assin-resp">
      <div class="linha-r"></div>
      <div class="nome-r">${dados.instrutor || 'Anderson Bicalho Diniz'}</div>
      <div class="cargo-r">
        Instrutor e responsável Técnico<br>
        Engenheiro Eletricista<br>
        Engenheiro Segurança do Trabalho<br>
        Crea: ${dados.crea || '254516/MG'}
      </div>
    </div>
  </div>
</div>

<!-- ══ VERSO ══ -->
<div class="pagina-verso">
  <div class="verso-header">
    <div class="verso-logo">
      <img src="${logoPath}" alt="NR Certifica" />
    </div>
    <div class="verso-titulo">
      <h1>${dados.titulo_curso}</h1>
      <h2>CONTEÚDO PROGRAMÁTICO — ${dados.carga_horaria?.toUpperCase()}</h2>
    </div>
  </div>

  <div class="grid-cols">
    <div>${col1.map(renderItem).join('')}</div>
    <div>${col2.map(renderItem).join('')}</div>
  </div>

  <div class="verso-footer">
    <div class="footer-esq">
      <div class="footer-logo">
        <img src="${logoPath}" alt="" />
      </div>
      <div class="base-legal-v">
        Curso (modalidade EAD) com fundamento legal na Constituição Federal/88 Artigo 206o Inciso II e Artigo 209o,<br>
        Lei no 9.394/96, Decreto no 5.154/2004 e Norma CNE no 04/99 - MEC (Ministério da Educação) Artigo 7o § 3o.<br>
        Validade do treinamento: até <strong>${dataValidade}</strong>.
        <div class="codigo-box">Código: ${cert.codigo} · Verifique em: nrcertifica.com.br/validar/${cert.codigo}</div>
      </div>
    </div>
    <div class="assin-v">
      <div class="linha-v"></div>
      <div class="nome-v">${dados.instrutor || 'Anderson Bicalho Diniz'}</div>
      <div class="cargo-v">
        Engenheiro Eletricista<br>
        Engenheiro Segurança do trabalho<br>
        Eletricom Manutenção Especializada<br>
        CREA: ${dados.crea || '254516/MG'}<br>
        Registro Nacional: 1419524216
      </div>
    </div>
  </div>
</div>

</body></html>`
}
